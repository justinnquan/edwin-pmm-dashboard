{
  "name": "edwin-pmm-dashboard",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/check-layers.ts && tsc --noEmit && tsc --noEmit -p tsconfig.api.json && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.api.json",
    "null-test": "tsx scripts/null-test.ts",
    "preview": "vite preview",
    "check:layers": "tsx scripts/check-layers.ts",
    "export-sample": "tsx scripts/export-sample.ts",
    "gen:requirements": "tsx scripts/gen-requirements.ts"
  },
  "dependencies": {
    "@types/papaparse": "^5.5.2",
    "@vercel/blob": "^2.8.0",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
